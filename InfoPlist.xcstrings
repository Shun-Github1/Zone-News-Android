    "about.description.1" : {
      "comment" : "About description paragraph 1",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zone News brings you the stories that matter in a scientific and transparent manner. We seek to pop information bubbles through concise, comprehensive and convenient reporting, showcasing multiple perspectives of every event."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zone News 以 科学透明的方式 为您带来重要新闻。我们力求通过简洁、全面、便捷的报道，展现每个事件的多重视角，打破信息泡沫。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zone News 以 科學透明的方式 為您帶來重要新聞。我們力求透過簡潔、全面、便利的報道，展現每個事件的多重視角，打破資訊泡沫。"
          }
        }
      }
    },
    "about.description.2" : {
      "comment" : "About description paragraph 2",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Our mission is information: reimagining your news feed by allowing you to collate information from dozens of sources across time and space with ease. We provide balanced, accurate and timely intelligence on politics, technology, sports and more, across Hong Kong, China and beyond."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们的使命是信息：重新构想您的新闻信息流，让您轻松汇集来自不同时间和地点的多个来源的信息。我们提供 平衡、准确和及时 的政治、科技、体育等新闻信息，涵盖香港、中国及其他地区。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我們的使命是訊息：重新構想您的新聞資訊流，讓您輕鬆匯集來自不同時間和地點的多個來源的信息。我們提供平衡、準確和及時的政治、科技、體育等新聞資訊，涵蓋香港、中國及其他地區。"
          }
        }
      }
    },
