    "personal.recap.daily.bullet1" : {
      "comment" : "Daily recap bullet point 1",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Major tech breakthrough: OpenAI announced GPT-5 with enhanced reasoning capabilities, while Apple revealed new AI features for iOS 18. The tech sector saw significant market movements with NVIDIA reaching new highs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重大科技突破：OpenAI宣布GPT-5具有增强推理能力，苹果为iOS 18推出新AI功能。科技板块出现重大市场波动，英伟达创历史新高。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重大科技突破：OpenAI宣布GPT-5具有增強推理能力，蘋果為iOS 18推出新AI功能。科技板塊出現重大市場波動，英偉達創歷史新高。"
          }
        }
      }
    },
    "personal.recap.daily.bullet2" : {
      "comment" : "Daily recap bullet point 2",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Global climate summit concludes with new carbon reduction targets. 195 countries agreed to accelerate renewable energy adoption, with major commitments from China and the EU to achieve net-zero emissions by 2050."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全球气候峰会结束，制定新的碳减排目标。195个国家同意加速可再生能源采用，中国和欧盟承诺到2050年实现净零排放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全球氣候峰會結束，制定新的碳減排目標。195個國家同意加速可再生能源採用，中國和歐盟承諾到2050年實現淨零排放。"
          }
        }
      }
    },
    "personal.recap.daily.bullet3" : {
      "comment" : "Daily recap bullet point 3",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Economic update: Federal Reserve maintains interest rates at 5.25%, citing inflation concerns. Stock markets showed mixed results with tech stocks rallying while energy sector declined due to oil price volatility."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "经济动态：美联储维持利率在5.25%，引用通胀担忧。股市表现不一，科技股上涨而能源板块因油价波动下跌。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "經濟動態：美聯儲維持利率在5.25%，引用通脹擔憂。股市表現不一，科技股上漲而能源板塊因油價波動下跌。"
          }
        }
      }
    },
    "personal.recap.daily.bullet4" : {
      "comment" : "Daily recap bullet point 4",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "International relations: New trade agreement signed between US and India, focusing on semiconductor manufacturing and clean energy cooperation. The deal is expected to create 50,000 jobs and strengthen supply chain resilience."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "国际关系：美国和印度签署新贸易协议，专注于半导体制造和清洁能源合作。该协议预计创造5万个就业岗位并加强供应链韧性。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "國際關係：美國和印度簽署新貿易協議，專注於半導體製造和清潔能源合作。該協議預計創造5萬個就業崗位並加強供應鏈韌性。"
          }
        }
      }
    },
    "personal.recap.daily.bullet5" : {
      "comment" : "Daily recap bullet point 5",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Healthcare breakthrough: New mRNA vaccine technology shows 95% effectiveness against multiple cancer types in clinical trials. The treatment could revolutionize oncology care and be available within 2-3 years."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "医疗突破：新mRNA疫苗技术在临床试验中对多种癌症类型显示95%有效性。该治疗可能革命性改变肿瘤护理，2-3年内可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "醫療突破：新mRNA疫苗技術在臨床試驗中對多種癌症類型顯示95%有效性。該治療可能革命性改變腫瘤護理，2-3年內可用。"
          }
        }
      }
    },
    "personal.recap.daily.header" : {
      "comment" : "Daily recap header",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Last 24 hours"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "过去24小时"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "過去24小時"
          }
        }
      }
    },
    "personal.recap.monthly.bullet1" : {
      "comment" : "Monthly recap bullet point 1",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Artificial Intelligence revolution: This month marked a turning point in AI development with major breakthroughs in quantum computing integration, achieving 99.7% accuracy in complex problem-solving. Tech giants invested $50 billion in AI infrastructure, while regulatory frameworks were established in 15 countries."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人工智能革命：本月标志着AI发展的转折点，量子计算集成取得重大突破，复杂问题解决准确率达到99.7%。科技巨头在AI基础设施投资500亿美元，15个国家建立监管框架。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "人工智能革命：本月標誌著AI發展的轉折點，量子計算集成取得重大突破，複雜問題解決準確率達到99.7%。科技巨頭在AI基礎設施投資500億美元，15個國家建立監管框架。"
          }
        }
      }
    },
    "personal.recap.monthly.bullet2" : {
      "comment" : "Monthly recap bullet point 2",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Global economic transformation: The world economy underwent significant restructuring with the introduction of digital currencies by 8 major central banks, renewable energy surpassing fossil fuels for the first time in history, and the establishment of new international trade corridors connecting Asia, Africa, and South America."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全球经济转型：世界经济经历重大重组，8个主要央行推出数字货币，可再生能源首次在历史上超越化石燃料，建立连接亚洲、非洲和南美洲的新国际贸易走廊。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全球經濟轉型：世界經濟經歷重大重組，8個主要央行推出數字貨幣，可再生能源首次在歷史上超越化石燃料，建立連接亞洲、非洲和南美洲的新國際貿易走廊。"
          }
        }
      }
    },
    "personal.recap.monthly.bullet3" : {
      "comment" : "Monthly recap bullet point 3",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Climate action breakthrough: Historic agreement reached at the Global Climate Summit with 195 countries committing to net-zero emissions by 2035, 10 years earlier than previous targets. Carbon capture technology achieved 95% efficiency, while ocean cleanup initiatives removed 2 million tons of plastic waste."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "气候行动突破：全球气候峰会达成历史性协议，195个国家承诺到2035年实现净零排放，比之前目标提前10年。碳捕获技术达到95%效率，海洋清理倡议清除200万吨塑料废物。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "氣候行動突破：全球氣候峰會達成歷史性協議，195個國家承諾到2035年實現淨零排放，比之前目標提前10年。碳捕獲技術達到95%效率，海洋清理倡議清除200萬噸塑料廢物。"
          }
        }
      }
    },
    "personal.recap.monthly.bullet4" : {
      "comment" : "Monthly recap bullet point 4",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Healthcare revolution: Revolutionary medical breakthroughs this month included the first successful human organ regeneration using stem cell technology, AI-powered drug discovery reducing development time by 70%, and the launch of universal healthcare coverage in 12 additional countries, bringing total global coverage to 85%."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "医疗革命：本月革命性医疗突破包括首次使用干细胞技术成功再生人体器官，AI药物发现将开发时间减少70%，12个额外国家启动全民医疗覆盖，全球总覆盖率达到85%。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "醫療革命：本月革命性醫療突破包括首次使用幹細胞技術成功再生人體器官，AI藥物發現將開發時間減少70%，12個額外國家啟動全民醫療覆蓋，全球總覆蓋率達到85%。"
          }
        }
      }
    },
    "personal.recap.monthly.bullet5" : {
      "comment" : "Monthly recap bullet point 5",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Space exploration achievements: This month witnessed unprecedented progress in space exploration with the successful establishment of the first permanent lunar base, Mars rover discovering evidence of ancient microbial life, and the launch of the first commercial space station hosting 12 international research projects worth $2.5 billion."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "太空探索成就：本月太空探索取得前所未有的进展，成功建立第一个永久月球基地，火星探测器发现古代微生物生命证据，首个商业空间站发射，承载12个价值25亿美元的国际研究项目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
