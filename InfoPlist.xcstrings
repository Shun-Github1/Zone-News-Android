    "personal.recap.weekly.bullet1" : {
      "comment" : "Weekly recap bullet point 1",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tech industry transformation: This week saw major AI developments with Google launching Gemini 2.0, Microsoft integrating Copilot across all Office products, and Meta announcing new VR headset with neural interface technology. The AI market cap reached $2.3 trillion."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "科技行业转型：本周AI重大发展，谷歌推出Gemini 2.0，微软在所有Office产品中集成Copilot，Meta宣布配备神经接口技术的新VR头显。AI市值达到2.3万亿美元。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "科技行業轉型：本週AI重大發展，谷歌推出Gemini 2.0，微軟在所有Office產品中集成Copilot，Meta宣布配備神經接口技術的新VR頭顯。AI市值達到2.3萬億美元。"
          }
        }
      }
    },
    "personal.recap.weekly.bullet2" : {
      "comment" : "Weekly recap bullet point 2",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Global economic shifts: Central banks worldwide adjusted monetary policies with the ECB cutting rates by 0.5%, Bank of Japan ending negative interest rates, and emerging markets seeing increased foreign investment. The global economy shows signs of stabilization."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全球经济变化：全球央行调整货币政策，欧洲央行降息0.5%，日本银行结束负利率，新兴市场外国投资增加。全球经济显现稳定迹象。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全球經濟變化：全球央行調整貨幣政策，歐洲央行降息0.5%，日本銀行結束負利率，新興市場外國投資增加。全球經濟顯現穩定跡象。"
          }
        }
      }
    },
    "personal.recap.weekly.bullet3" : {
      "comment" : "Weekly recap bullet point 3",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Climate action progress: Major breakthrough in renewable energy as solar panel efficiency reached 47% in laboratory tests. Wind energy installations increased 35% globally, while carbon capture technology saw $12 billion in new investments this week."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "气候行动进展：可再生能源重大突破，太阳能电池板效率在实验室测试中达到47%。全球风力发电装置增加35%，碳捕获技术本周获得120亿美元新投资。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "氣候行動進展：可再生能源重大突破，太陽能電池板效率在實驗室測試中達到47%。全球風力發電裝置增加35%，碳捕獲技術本週獲得120億美元新投資。"
          }
        }
      }
    },
    "personal.recap.weekly.bullet4" : {
      "comment" : "Weekly recap bullet point 4",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Healthcare innovations: Revolutionary gene therapy treatments showed 90% success rate in treating rare genetic disorders. New telemedicine platforms expanded access to healthcare in rural areas, while AI-powered diagnostic tools reduced misdiagnosis rates by 40%."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "医疗创新：革命性基因治疗在治疗罕见遗传疾病方面显示90%成功率。新远程医疗平台扩大农村地区医疗保健覆盖，AI诊断工具将误诊率降低40%。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "醫療創新：革命性基因治療在治療罕見遺傳疾病方面顯示90%成功率。新遠程醫療平台擴大農村地區醫療保健覆蓋，AI診斷工具將誤診率降低40%。"
          }
        }
      }
    },
    "personal.recap.weekly.bullet5" : {
