    "tutorial.home.step1" : {
      "comment" : "Home tutorial step 1 message",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Home page is your default news feed, showing breaking and relevant news from around the world."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首页是您的默认新闻动态，展示来自世界各地的突发和相关新闻。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "首頁是您的預設新聞動態，展示來自世界各地的突發和相關新聞。"
          }
        }
      }
    },
    "tutorial.home.step2" : {
      "comment" : "Home tutorial step 2 message",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unlike traditional news platforms, each news card shows a news event with multiple reports, instead of an individual article."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "与传统新闻平台不同，每张新闻卡片展示的是由多篇报导综合而成的一个新闻事件，而非单一文章。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與傳統新聞平台不同，每張新聞卡片展示的是由多篇報導綜合而成的一個新聞事件，而非單一文章。"
          }
        }
      }
    },
    "tutorial.home.step3" : {
      "comment" : "Home tutorial step 3 message",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This bar represents the net media sentiment towards this event, illustrating the outlet’s attitude."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此条形图显示媒体对该事件的综合情感分析，反映媒体的态度。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此條形圖顯示媒體對該事件的綜合情感分析，反映媒體的態度。"
          }
        }
      }
    },
    "tutorial.home.welcome" : {
      "comment" : "Welcome message shown before home tutorial",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Welcome to your one stop news platform for the future! Let's go through some of the main features."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "欢迎来到您的全新一站式新闻平台！让我们来了解一下主要功能。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "歡迎來到您的全新一站式新聞平台！讓我們來了解一下主要功能。"
          }
        }
      }
    },
    "tutorial.newsdetail.step1" : {
      "comment" : "News detail tutorial step 1 message",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zone News summaries are generated from all the media reports on this event, quick select the level of depth and language by tapping the gear icon. Ask for more using the button below."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zone News 摘要由该事件的所有媒体报导综合而成，点选齿轮图标来选择深度和语言。点击下方按钮了解更多。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zone News 摘要由該事件的所有媒體報導綜合而成，點選齒輪圖標來選擇深度和語言。點擊下方按鈕了解更多。"
          }
        }
      }
    },
    "tutorial.newsdetail.step2" : {
      "comment" : "News detail tutorial step 2 message",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This diagram shows media reporting patterns on this news event: who's reporting, their usual bias, and when."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此图表展示该新闻事件的媒体报导模式：有什么媒体在报导、其一贯的立场以及报导时间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此圖表展示該新聞事件的媒體報導模式：有什麼媒體在報導、其一貫的立場以及報導時間。"
          }
        }
      }
    },
    "tutorial.newsdetail.step3" : {
      "comment" : "News detail tutorial step 3 message",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This score represents how objective media reporting on this event is overall: a lower score is better."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此分数表示媒体对该事件报道的整体客观程度：分数越低越好。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此分數表示媒體對該事件報導的整體客觀程度：分數越低越好。"
          }
        }
      }
    },
    "tutorial.newsdetail.step4" : {
      "comment" : "News detail tutorial step 4 message",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Read from the articles directly for proper reporting. You can also tap on the logos to get an overview of the media."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请直接阅读原文以确保报导准确无误。您亦可点击图标获取媒体简介。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請直接閱讀原文以確保報導準確無誤。您亦可點擊圖標獲取媒體簡介。"
          }
        }
      }
    },
    "tutorial.personal.step1" : {
      "comment" : "Personal tutorial step 1 message",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personal page enables you to create your own news feed by selecting what is relevant to you."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "个人页面让您可以通过选择与您相关的内容来创建自己的新闻动态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個人頁面讓您可以通過選擇與您相關的內容來創建自己的新聞動態。"
          }
        }
      }
    },
    "tutorial.personal.step2" : {
      "comment" : "Personal tutorial step 2 message",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Follow and get notifications on topics of interest as well as breaking news events by selecting them in Active Tags."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「关注的主题」中选择感兴趣的主题，即可关注并获取相关通知及突发新闻事件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「關注的主題」中選擇感興趣的主題，即可關注並獲取相關通知及突發新聞事件。"
          }
        }
      }
    },
    "tutorial.personal.step3" : {
      "comment" : "Personal tutorial step 3 message",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Missed the news? Recap catches you up on the headlines from the previous day, week or even month."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "错过新闻了？回顾功能帮您快速了解前一天、一周甚至一个月的重要头条。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "錯過新聞了？回顧功能幫您快速了解前一天、一週甚至一個月的重要頭條。"
          }
        }
      }
    },
    "tutorial.personal.step4" : {
      "comment" : "Personal tutorial step 4 message",
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Don't let the news get you down. Levity mode is a newsletter showing all the good that's happening in the world."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要让新闻让您沮丧。正向模式只展示世界上美好事件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要讓新聞讓您沮喪。正向模式只展示世界上美好事件。"
          }
        }
      }
    },
