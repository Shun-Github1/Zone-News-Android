<?xml version="1.0" encoding="utf-8"?><!-- 层叠 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:id="@android:id/background">
        <shape>
            <corners android:radius="2dp" />

            <gradient
                android:angle="270"
                android:centerColor="@color/colorTextSmall"
                android:endColor="@color/colorTextSmall"
                android:startColor="@color/colorTextSmall" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <corners android:radius="2dp" />

                <gradient
                                    android:centerColor="@color/green"
                android:endColor="@color/brand_primary"
                android:startColor="@color/brand_primary" />
            </shape>
        </clip>
    </item>

</layer-list>