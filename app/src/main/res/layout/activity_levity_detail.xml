<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F0F8FF">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:stateListAnimator="@null"
        app:liftOnScroll="false"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@android:color/transparent"
            app:menu="@menu/menu_news_detail"
            app:navigationIcon="@drawable/ic_arrow_back_ios"
            app:navigationIconTint="@color/colorTextDeep">
        </com.google.android.material.appbar.MaterialToolbar>
    </com.google.android.material.appbar.AppBarLayout>

    <include
        android:id="@+id/shimmer_layout"
        layout="@layout/shimmer_levity_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:visibility="visible" />

    <LinearLayout
        android:id="@+id/error_state_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="?attr/actionBarSize"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <com.searcher.zonenews.widget.CatMascotView
            android:id="@+id/error_mascot"
            android:layout_width="120dp"
            android:layout_height="120dp" />

        <TextView
            android:id="@+id/error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/levity_error_failed"
            android:textColor="@color/colorTextDeep"
            android:textSize="16sp" />

        <Button
            android:id="@+id/error_retry_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/button_retry" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/content_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="17dp"
                android:paddingTop="16dp">

                 <!-- Image -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    android:layout_marginBottom="16dp">
                    <ImageView
                        android:id="@+id/news_iv"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_image_not_supported_24" />
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/title_tv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#2C3E50"
                    android:layout_marginBottom="12dp" />
            </LinearLayout>

            <!-- Summary Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/summary_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardForegroundColor="@android:color/transparent"
                app:strokeColor="@android:color/transparent"
                android:backgroundTint="?attr/colorSurface"
                app:cardUseCompatPadding="true"
                app:cardElevation="4dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_content_background"
                    android:padding="16dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_ai_compass_24"
                            android:tint="#9AEDDD"
                            android:layout_marginEnd="8dp" />
                        
                        <TextView
                            android:id="@+id/synopsis_header"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/levity_summary"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#2C3E50" />
                        
                        <com.searcher.zonenews.widget.CatMascotView
                            android:id="@+id/summary_mascot"
                            android:layout_width="24dp"
                            android:layout_height="24dp" />
                    </LinearLayout>
                    
                    <TextView
                        android:id="@+id/synopsis_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="#34495E"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Why it Matters Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/implications_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardForegroundColor="@android:color/transparent"
                app:strokeColor="@android:color/transparent"
                android:backgroundTint="?attr/colorSurface"
                app:cardUseCompatPadding="true"
                app:cardElevation="4dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_content_background"
                    android:padding="16dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_lightbulb_24"
                            android:tint="#FFB6C1"
                            android:layout_marginEnd="8dp" />
                        
                        <TextView
                            android:id="@+id/implications_header"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/levity_why_it_matters"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#2C3E50" />
                        
                        <com.searcher.zonenews.widget.CatMascotView
                            android:id="@+id/implications_mascot"
                            android:layout_width="24dp"
                            android:layout_height="24dp" />
                    </LinearLayout>
                    
                    <TextView
                        android:id="@+id/implications_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="16sp"
                        android:textColor="#34495E"
                        android:lineSpacingExtra="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Publisher Articles Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/publisher_articles_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardForegroundColor="@android:color/transparent"
                app:strokeColor="@android:color/transparent"
                android:backgroundTint="?attr/colorSurface"
                app:cardUseCompatPadding="true"
                app:cardElevation="4dp">
                
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_content_background"
                    android:padding="16dp">
                    
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="8dp">
                        
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_layers_24"
                            android:tint="#9AEDDD"
                            android:layout_marginEnd="8dp" />
                        
                        <TextView
                            android:id="@+id/publisher_articles_header"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/publisher_articles"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#2C3E50" />
                        
                        <com.searcher.zonenews.widget.CatMascotView
                            android:id="@+id/publisher_articles_mascot"
                            android:layout_width="24dp"
                            android:layout_height="24dp" />
                    </LinearLayout>
                    
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/levity_publisher_articles_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom spacing buffer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="13dp" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
