<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:background="?attr/colorSurface"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Zone News Logo - positioned outside fragment container to avoid fade animations -->
    <!-- Placed after container in XML so it draws on top -->
    <ImageView
        android:id="@+id/brand_logo"
        android:layout_width="200dp"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:layout_marginStart="6dp"
        android:src="@drawable/pg_home_top_news"
        android:contentDescription="@string/app_name"
        android:scaleType="fitStart"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <FrameLayout
        android:id="@+id/mainBottomCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent">

        <eightbitlab.com.blurview.BlurView
            android:id="@+id/mainBottomBlurView"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_gravity="top" />

        <View
            android:id="@+id/mainBottomGlassOverlay"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_gravity="top" />

        <!-- Sliding indicator that animates behind selected tab -->
        <View
            android:id="@+id/bottomNavIndicator"
            android:layout_width="0dp"
            android:layout_height="47dp"
            android:layout_gravity="top"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:layout_marginBottom="4dp"
            android:visibility="invisible" />

        <RadioGroup
            android:id="@+id/mainRg"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:padding="4dp"
            android:background="@android:color/transparent"
            android:orientation="horizontal"
            android:layout_gravity="top">

                    <RadioButton
                        android:id="@+id/home_rb"
                        style="@style/tabStyle"
                        android:checked="true"
                        android:drawableTop="@drawable/home_selector"
                        android:text="@string/main_page" />

                    <RadioButton
                        android:id="@+id/special_rb"
                        style="@style/tabStyle"
                        android:drawableTop="@drawable/special_selector"
                        android:text="@string/person_recommend" />

                    <RadioButton
                        android:id="@+id/my_rb"
                        style="@style/tabStyle"
                        android:drawableTop="@drawable/my_selector"
                        android:text="@string/my" />

                    <RadioButton
                        android:id="@+id/search_rb"
                        style="@style/tabStyle"
                        android:drawableTop="@drawable/search_selector"
                        android:text="@string/discover" />
        </RadioGroup>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>