<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:background="?attr/colorSurface"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/top_app_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorSurface"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/menu_news_detail"
        app:navigationIcon="@drawable/ic_arrow_back_ios"
        app:navigationIconTint="@color/brand_primary"/>
   <androidx.core.widget.NestedScrollView
       android:id="@+id/newsDetailScrollView"
       android:layout_width="match_parent"
       android:layout_height="0dp"
       android:overScrollMode="never"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_app_bar"
       >
       <LinearLayout
           android:layout_width="match_parent"
           android:orientation="vertical"
           android:layout_height="wrap_content">
           <ImageView
               android:layout_width="match_parent"
               android:layout_height="225dp"
               android:scaleType="centerCrop"
               android:contentDescription="@null"
               android:id="@+id/news_iv"
               />
           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="vertical"
               android:background="?attr/colorSurface"
               android:padding="16dp"
               >
                <TextView
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                    android:textSize="20sp"
                   android:id="@+id/news_title_tv"
                   android:textColor="@color/colorTextDeep"
                   android:textStyle="bold"
                   />
                <!-- Synopsis section -->
                <LinearLayout
                    android:id="@+id/synopsisContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="13dp"
                    android:layout_marginBottom="4dp">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Summary"
                        android:textSize="12sp"
                        android:textColor="@color/brand_primary"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />
                    
                    <TextView
                        android:id="@+id/newsSynopsisTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/colorTextMiddle"
                        android:background="@drawable/card_content_background"
                        android:padding="12dp"
                        android:lineSpacingExtra="4dp" />
                        
                </LinearLayout>
                
                <!-- Implications section -->
                <LinearLayout
                    android:id="@+id/implicationsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="16dp"
                    android:visibility="gone">
                    
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Analysis &amp; Implications"
                        android:textSize="12sp"
                        android:textColor="@color/brand_primary"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />
                    
                    <TextView
                        android:id="@+id/newsImplicationsTv"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textColor="@color/colorTextMiddle"
                        android:background="@drawable/card_content_background"
                        android:padding="12dp"
                        android:lineSpacingExtra="4dp" />
                        
                </LinearLayout>
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/generateContextBtn"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="22dp"
                    android:layout_marginStart="36dp"
                    android:layout_marginEnd="36dp"
                   android:text="@string/context"
                   app:icon="@drawable/ic_ai_compass_white_24"
                   app:iconGravity="textStart"
                   app:iconPadding="8dp"
                   app:cornerRadius="8dp"
                   app:backgroundTint="@color/brand_primary"
                   android:textColor="@android:color/white"
                   />
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_marginTop="16dp"
                    android:layout_height="wrap_content">
                    <TextView
                        android:id="@+id/searcherAiAttribution"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/searcher_ai_attribution"
                        android:textColor="#999999"
                        android:textSize="11sp"
                        android:gravity="start|center_vertical"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintLeft_toLeftOf="parent"
                        app:layout_constraintRight_toLeftOf="@+id/feedBackLayout"
                        android:layout_marginEnd="12dp" />
                    <com.hjq.shape.layout.ShapeRelativeLayout
                        android:id="@+id/feedBackLayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingVertical="4dp"
                        android:paddingHorizontal="10dp"
                        app:shape_radius="6dp"
                        app:shape_solidColor="@android:color/transparent"
                        app:shape_solidPressedColor="@android:color/transparent"
                        app:shape_strokeColor="@color/colorTextMiddle"
                        app:shape_strokeSize="1dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintRight_toRightOf="parent">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="13sp"
                            android:drawablePadding="6dp"
                            android:text="@string/feedback"
                            android:textColor="@color/colorTextMiddle"
                            app:drawableStartCompat="@drawable/ic_feedback_16"
                            app:drawableTint="@color/colorTextMiddle" />
                    </com.hjq.shape.layout.ShapeRelativeLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
           </LinearLayout>
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardForegroundColor="@android:color/transparent"
                app:strokeColor="@android:color/transparent"
                android:backgroundTint="?attr/colorSurface"
                app:cardUseCompatPadding="true"
                app:cardElevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_content_background"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/sentiment_score"
                            android:textColor="@color/colorTextDeep"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                        <ImageView
                            android:id="@+id/sentiment_info_btn"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_info_outline_18"
                            android:tint="@color/colorTextSmall"/>
                    </LinearLayout>
                    <com.anssy.znewspro.ui.newsdetail.SentimentMeterView
                        android:id="@+id/sentimentMeter"
                        android:layout_width="match_parent"
                        android:layout_height="148dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardForegroundColor="@android:color/transparent"
                app:strokeColor="@android:color/transparent"
                android:backgroundTint="?attr/colorSurface"
                app:cardUseCompatPadding="true"
                app:cardElevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_content_background"
                    android:padding="16dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/publisher_distribution"
                            android:textColor="@color/colorTextDeep"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                        <ImageView
                            android:id="@+id/publisher_info_btn"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_info_outline_18"
                            android:tint="@color/colorTextSmall"/>
                    </LinearLayout>

                    <com.anssy.znewspro.ui.newsdetail.PublisherDistributionView
                        android:id="@+id/publisherDistribution"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:layout_marginTop="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="8dp">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="#9CA3AF"
                                android:layout_marginEnd="6dp"
                                android:layout_gravity="center_vertical"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/conservative"
                                android:textSize="12sp"
                                android:textColor="@color/colorTextSmall"/>
                        </LinearLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1"
                            android:background="@android:color/transparent"/>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <View
                                android:layout_width="12dp"
                                android:layout_height="12dp"
                                android:background="#6B7280"
                                android:layout_marginEnd="6dp"
                                android:layout_gravity="center_vertical"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/progressive"
                                android:textSize="12sp"
                                android:textColor="@color/colorTextSmall"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardForegroundColor="@android:color/transparent"
                app:strokeColor="@android:color/transparent"
                android:backgroundTint="?attr/colorSurface"
                app:cardUseCompatPadding="true"
                app:cardElevation="4dp">
                <com.anssy.znewspro.ui.newsdetail.SubjectivityScoreView
                    android:background="@drawable/card_content_background"
                    android:id="@+id/subjectivity_score"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp"
                app:cardCornerRadius="12dp"
                app:cardBackgroundColor="?attr/colorSurface"
                app:cardForegroundColor="@android:color/transparent"
                app:strokeColor="@android:color/transparent"
                android:backgroundTint="?attr/colorSurface"
                app:cardUseCompatPadding="true"
                app:cardElevation="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/card_content_background"
                    android:padding="16dp">
                    
                    <!-- Header with title and sort button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/publisher_articles"
                            android:textColor="@color/colorTextDeep"
                            android:textSize="16sp"
                            android:textStyle="bold"/>
                        
                        <!-- Sort controls container -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            
                            <!-- Sort option indicator button -->
                            <LinearLayout
                                android:id="@+id/sort_option_button"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/sort_icon_border"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="4dp"
                                android:clickable="true"
                                android:focusable="true">
                                
                                <!-- Sort option icon -->
                                <ImageView
                                    android:id="@+id/sort_option_icon"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_building_2_24"
                                    android:contentDescription="@null"
                                    android:layout_marginEnd="4dp"
                                    app:tint="@color/colorTextSmall"/>
                                
                                <!-- Sort option text -->
                                <TextView
                                    android:id="@+id/sort_option_text"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/publisher_name"
                                    android:textColor="@color/colorTextSmall"
                                    android:textSize="12sp"/>
                            </LinearLayout>
                            
                            <!-- Arrow container with rounded background -->
                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:background="@drawable/sort_icon_border"
                                android:padding="4dp"
                                android:layout_marginStart="8dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:id="@+id/sort_direction_button">
                                
                                <!-- Up arrow -->
                                <ImageView
                                    android:id="@+id/sort_indicator_arrow_up"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_arrow_up_24"
                                    android:contentDescription="@null"
                                    app:tint="@color/colorTextSmall"/>
                                
                                <!-- Down arrow -->
                                <ImageView
                                    android:id="@+id/sort_indicator_arrow_down"
                                    android:layout_width="16dp"
                                    android:layout_height="16dp"
                                    android:src="@drawable/ic_arrow_down_24"
                                    android:contentDescription="@null"
                                    app:tint="@color/colorTextSmall"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/publisher_articles_list"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_publisher_article"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            
            <!-- Bottom padding to account for floating bar -->
            <View
                android:layout_width="match_parent"
                android:layout_height="67dp"
                android:background="@android:color/transparent"/>
       </LinearLayout>
   </androidx.core.widget.NestedScrollView>
   
   <!-- Floating Bottom Bar -->
   <com.google.android.material.card.MaterialCardView
       android:id="@+id/newsDetailBottomCard"
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:layout_margin="12dp"
       style="@style/Widget.Material3.CardView.Elevated"
       app:cardCornerRadius="14dp"
       app:cardBackgroundColor="?attr/colorSurface"
       app:cardForegroundColor="@android:color/transparent"
       app:strokeColor="@android:color/transparent"
       android:backgroundTint="?attr/colorSurface"
       app:cardElevation="4dp"
       app:layout_constraintBottom_toBottomOf="parent">

       <RadioGroup
           android:id="@+id/newsDetailRg"
           android:layout_width="match_parent"
           android:layout_height="55dp"
           android:padding="4dp"
           android:background="?attr/colorSurface"
           android:orientation="horizontal">

           <RadioButton
               android:id="@+id/news_detail_home_rb"
               style="@style/tabStyle"
               android:drawableTop="@drawable/home_selector"
               android:text="@string/main_page" />

           <RadioButton
               android:id="@+id/news_detail_special_rb"
               style="@style/tabStyle"
               android:drawableTop="@drawable/special_selector"
               android:text="@string/person_recommend" />

           <RadioButton
               android:id="@+id/news_detail_my_rb"
               style="@style/tabStyle"
               android:drawableTop="@drawable/my_selector"
               android:text="@string/my" />

           <RadioButton
               android:id="@+id/news_detail_search_rb"
               style="@style/tabStyle"
               android:drawableTop="@drawable/search_selector"
               android:text="@string/discover" />
       </RadioGroup>
   </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>