<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:fitsSystemWindows="true"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- MaterialToolbar for consistent top bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="?attr/colorSurface"
        android:elevation="0dp"
        app:title=""
        app:titleTextColor="@color/colorTextDeep"
        app:titleTextAppearance="@style/ProfileHeadingStyle"
        app:menu="@menu/menu_notifications_toolbar"
        style="@style/Widget.Material3.Toolbar"
        app:contentInsetStart="6dp"
        app:contentInsetStartWithNavigation="6dp"
        app:contentInsetEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        
        <!-- Custom layout for logo and title -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="start|center_vertical">
            
            <!-- Brand Logo -->
            <ImageView
                android:id="@+id/brand_logo"
                android:layout_width="200dp"
                android:layout_height="48dp"
                android:src="@drawable/pg_home_top_news"
                android:contentDescription="@string/app_name"
                android:scaleType="fitStart" />
            
        </LinearLayout>
        
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Empty state content -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Large bell icon -->
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:contentDescription="@string/notifications"
            android:src="@drawable/ic_notifications_outline_24"
            android:tint="@color/colorTextMiddle"
            android:layout_marginBottom="16dp" />

        <!-- Notifications text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notifications"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/colorTextDeep"
            android:fontFamily="@font/custom" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
