<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="?attr/colorSurface"
        app:navigationIcon="@drawable/ic_arrow_back_ios"
        app:navigationIconTint="@color/brand_primary"
        app:menu="@menu/menu_browser_toolbar"
        style="@style/Widget.Material3.Toolbar">
        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical|start">
            
            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/media_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ease_default_image"
                android:background="@android:color/transparent"
                android:layout_marginEnd="8dp"
                app:shapeAppearance="@style/ShapeAppearance.Material3.Corner.Full"
                app:strokeColor="@color/divider_color"
                app:strokeWidth="1dp"/>
                
            <TextView
                android:id="@+id/media_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorTextDeep"
                android:textSize="14sp"
                android:fontFamily="@font/custom"
                android:maxLines="1"
                android:ellipsize="end"/>
                
        </LinearLayout>
        
    </com.google.android.material.appbar.MaterialToolbar>

    <com.anssy.znewspro.selfview.ProgressWebView
        android:id="@+id/agree_web"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/toolbar"
        android:overScrollMode="never" />

</RelativeLayout>