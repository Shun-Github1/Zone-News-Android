<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="?attr/colorSurface"
        android:elevation="0dp"
        app:title=""
        app:titleTextColor="@color/colorTextDeep"
        app:titleTextAppearance="@style/ProfileHeadingStyle"
        style="@style/Widget.Material3.Toolbar"
        app:contentInsetStart="6dp"
        app:contentInsetStartWithNavigation="6dp"
        app:contentInsetEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <FrameLayout
            android:id="@+id/levity_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/bg_levity_button"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/levity_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_wb_sunny_24"
                    android:layout_marginEnd="6dp"
                    app:tint="#FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/levity_button"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
            
        </FrameLayout>
        
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Subpage switch: Your Feed | Recap -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/personal_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.Material3.TabLayout"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:tabIndicator="@drawable/tab_indicator_fixed"
        app:tabIndicatorColor="@color/main_color"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorFullWidth="false"
        app:tabBackground="@null"
        app:tabRippleColor="@null"
        app:tabTextAppearance="@style/TabText"
        app:tabTextColor="@color/colorTextSmall"
        app:tabSelectedTextColor="@color/colorTextDeep"
        app:tabPaddingStart="0dp"
        app:tabPaddingEnd="0dp"
        app:tabPaddingTop="0dp"
        app:tabPaddingBottom="0dp"
        app:tabMinWidth="0dp"
        app:tabMaxWidth="0dp" />

    <!-- ViewPager2 for swipeable content -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/personal_view_pager"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/personal_tab_layout"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
