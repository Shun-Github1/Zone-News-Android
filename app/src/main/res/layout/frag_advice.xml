<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    
    <!-- MaterialToolbar (logo only, no action buttons) -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="?attr/colorSurface"
        android:elevation="0dp"
        app:title=""
        app:titleTextColor="@color/colorTextDeep"
        app:titleTextAppearance="@style/ProfileHeadingStyle"
        style="@style/Widget.Material3.Toolbar"
        app:contentInsetStart="6dp"
        app:contentInsetStartWithNavigation="6dp"
        app:contentInsetEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="start|center_vertical">

            <ImageView
                android:id="@+id/brand_logo"
                android:layout_width="200dp"
                android:layout_height="48dp"
                android:src="@drawable/pg_home_top_news"
                android:contentDescription="@string/app_name"
                android:scaleType="fitStart" />
        </LinearLayout>
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Subpage switch: Your Feed | Recap -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/personal_tab_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.Material3.TabLayout"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:tabIndicatorColor="@color/main_color"
        app:tabIndicatorHeight="4dp"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorFullWidth="false"
        app:tabBackground="@null"
        app:tabRippleColor="@null"
        app:tabTextAppearance="@style/TabText"
        app:tabTextColor="@color/colorTextSmall"
        app:tabSelectedTextColor="@color/colorTextDeep" />

    <!-- Currently sorted by indicator -->
    <LinearLayout
        android:id="@+id/sort_indicator_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/personal_tab_layout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <TextView
            android:id="@+id/sort_label_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/currently_sorted_by"
            android:textColor="@color/colorTextMiddle"
            android:textSize="16sp"
            android:fontFamily="@font/inter_regular" />
            
        <LinearLayout
            android:id="@+id/sort_chip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:background="@drawable/tag_chip_background"
            android:paddingLeft="8dp"
            android:paddingRight="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">
            
            <ImageView
                android:id="@+id/sort_info_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="6dp"
                android:src="@drawable/ic_clock_24"
                android:contentDescription="@null"
                android:tint="@color/colorTextMiddle" />
            
            <TextView
                android:id="@+id/sort_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/latest_sort"
                android:textColor="@color/colorTextDeep"
                android:textSize="14sp"
                android:fontFamily="@font/inter_regular" />
        </LinearLayout>
    </LinearLayout>

    <!-- Active tags indicator; click to manage topics via trailing chip -->
    <LinearLayout
        android:id="@+id/active_tags_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/sort_indicator_container"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
        
        <TextView
            android:id="@+id/active_tags_label_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/active_tags"
            android:textColor="@color/colorTextMiddle"
            android:textSize="16sp"
            android:fontFamily="@font/inter_regular" />
            
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/active_tags_chips_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:flexWrap="wrap"
            app:flexDirection="row"
            app:justifyContent="flex_start"
            app:alignItems="flex_start"
            android:layout_marginTop="6dp">
            <!-- Chips added dynamically -->
        </com.google.android.flexbox.FlexboxLayout>
    </LinearLayout>

    <com.hjq.shape.layout.ShapeRelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="8dp"
        android:padding="11dp"
        android:visibility="gone"
        app:shape_solidColor="?attr/colorSurfaceVariant"
        android:id="@+id/search_layout"
        app:shape_radius="6dp"
        app:layout_constraintTop_toBottomOf="@id/personal_tab_layout"
        >
        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_centerVertical="true"
            android:src="@drawable/icon_search"
            android:contentDescription="@null"
            android:id="@+id/search_iv"
            />
        <EditText
            android:id="@+id/searchEt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:hint="@string/discover_headline"
            android:importantForAutofill="no"
            android:textSize="14sp"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:layout_marginStart="6dp"
            android:textColor="@color/colorTextDeep"
            android:textColorHint="@color/colorTextHint"
            android:layout_toEndOf="@id/search_iv"
            />
    </com.hjq.shape.layout.ShapeRelativeLayout>
    <com.scwang.smartrefresh.layout.SmartRefreshLayout
        android:id="@+id/smartRefresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/active_tags_container"
        app:layout_goneMarginTop="8dp">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/homeRecycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never"

            />

    </com.scwang.smartrefresh.layout.SmartRefreshLayout>

    <!-- Recap container (visible when Recap tab selected) -->
    <FrameLayout
        android:id="@+id/recap_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/personal_tab_layout"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>