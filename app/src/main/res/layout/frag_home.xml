<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">
    
    <!-- MaterialToolbar for consistent top bar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:background="?attr/colorSurface"
        android:elevation="0dp"
        app:title=""
        app:titleTextColor="@color/colorTextDeep"
        app:titleTextAppearance="@style/ProfileHeadingStyle"
        app:menu="@menu/menu_home_toolbar"
        style="@style/Widget.Material3.Toolbar"
        app:contentInsetStart="6dp"
        app:contentInsetStartWithNavigation="6dp"
        app:contentInsetEnd="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        
        <!-- Logo removed - now in MainActivity layout to avoid fade animations -->
        
    </com.google.android.material.appbar.MaterialToolbar>

    <com.google.android.material.tabs.TabLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        style="@style/Widget.Material3.TabLayout"
        app:layout_constraintTop_toBottomOf="@id/toolbar"
        app:tabIndicator="@drawable/tab_indicator_fixed"
        app:tabIndicatorColor="@color/main_color"
        app:tabIndicatorHeight="3dp"
        app:tabMode="fixed"
        app:tabGravity="fill"
        app:tabIndicatorFullWidth="false"
        app:tabBackground="@null"
        app:tabRippleColor="@null"
        android:id="@+id/tab_layout"
        app:tabTextAppearance="@style/TabText"
        app:tabTextColor="@color/colorTextSmall"
        app:tabSelectedTextColor="@color/colorTextDeep"
        app:tabPaddingStart="0dp"
        app:tabPaddingEnd="0dp"
        app:tabPaddingTop="0dp"
        app:tabPaddingBottom="0dp"
        app:tabMinWidth="0dp"
        app:tabMaxWidth="0dp"
        >

    </com.google.android.material.tabs.TabLayout>
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/homeVp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/tab_layout"
        app:layout_constraintBottom_toBottomOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
