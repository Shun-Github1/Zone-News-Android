<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minHeight="600dp"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:layout_marginTop="80dp">

    <!-- Top Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/transparent"
        android:elevation="1dp">

        <!-- Close button on the left with brand color -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/closeButton"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="0dp"
            android:layout_marginTop="8dp"
            android:text="@string/close"
            android:textColor="@color/main_color"
            android:textSize="14sp"
            android:minWidth="0dp" />

    </RelativeLayout>

    <!-- Content Container with Header Overlay -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="400dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="0dp">

        <!-- News list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_quotes_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingTop="76dp"
            android:layout_marginTop="0dp"
            android:clipToPadding="false"
            tools:listitem="@layout/item_quote_bottom_sheet" />

        <!-- Large Header with Fade Background - overlays scrollable content -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:background="@drawable/bottom_sheet_scroll_fade_top"
            android:elevation="2dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/key_quotes_title"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextDeep"
                android:gravity="start"
                android:layout_marginStart="10dp"
                android:layout_marginTop="4dp" />
        </FrameLayout>

    </FrameLayout>

    <!-- Bottom spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="24dp" />

</LinearLayout>
