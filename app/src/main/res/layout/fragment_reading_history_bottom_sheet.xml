<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="600dp"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:layout_marginTop="80dp">

    <!-- Top Bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/transparent"
        android:elevation="1dp">

        <!-- Close button on the left with brand color -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/closeButton"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="0dp"
            android:layout_marginTop="8dp"
            android:text="@string/close"
            android:textColor="@color/main_color"
            android:textSize="14sp"
            android:minWidth="0dp" />

        <!-- Clear All button on the right in red -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/clearAllButton"
            style="?attr/borderlessButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="0dp"
            android:layout_marginTop="8dp"
            android:text="@string/clear_all"
            android:textColor="@color/colorRed"
            android:textSize="14sp"
            android:minWidth="0dp"
            android:visibility="gone"
            app:rippleColor="@color/colorRed" />

    </RelativeLayout>

    <!-- Content Container with Header Overlay -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="400dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="0dp">

        <!-- Loading view -->
        <LinearLayout
            android:id="@+id/loadingView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginBottom="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loading"
                android:textSize="14sp"
                android:textColor="@color/colorTextMiddle" />

        </LinearLayout>

        <!-- Empty state view -->
        <LinearLayout
            android:id="@+id/emptyView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:padding="32dp">

            <ImageView
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:src="@drawable/ic_clock_arrow_circlepath"
                android:contentDescription="@null"
                android:layout_marginBottom="20dp"
                app:tint="@color/colorTextSmall" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_browsing_history"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextDeep"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_browsing_history_subtitle"
                android:textSize="14sp"
                android:textColor="@color/colorTextMiddle"
                android:gravity="center" />

        </LinearLayout>

        <!-- News list -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/newsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:paddingTop="76dp"
            android:clipToPadding="false" />

        <!-- Large Header with Fade Background - overlays scrollable content -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:background="@drawable/bottom_sheet_scroll_fade_top"
            android:elevation="2dp">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/history"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextDeep"
                android:gravity="start"
                android:layout_marginStart="10dp"
                android:layout_marginTop="4dp" />
        </FrameLayout>

    </FrameLayout>

    <!-- Bottom spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="24dp" />

</LinearLayout>
