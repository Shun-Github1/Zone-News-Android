<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_background"
    android:layout_marginTop="80dp"
    android:clipToOutline="true">

    <!-- Content Container with Top Bar Overlay -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="400dp"
        android:clipToOutline="true">

        <!-- Content area -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:scrollbars="none"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Brand header to match login screen style -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:paddingTop="86dp">

                    <ImageView
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:layout_gravity="center_horizontal"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_person_add" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:text="@string/register_activity_title"
                        android:textColor="@color/colorTextDeep"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Full Name Field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:textColor="@color/colorTextDeep"
                    android:textSize="15sp"
                    android:text="@string/full_name"
                    android:textStyle="bold" />

                <com.hjq.shape.layout.ShapeRelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:shape_radius="12dp"
                    app:shape_solidColor="@color/light_gray">

                    <com.hjq.shape.view.ShapeEditText
                        android:id="@+id/nameEt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:textCursorDrawable="@drawable/cursor_color"
                        android:hint="@string/hint_username"
                        android:inputType="textPersonName"
                        android:drawableStart="@drawable/person_24px"
                        android:drawablePadding="8dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingVertical="10dp"
                        android:textColor="@color/colorTextDeep"
                        android:textColorHint="@color/colorTextHint"
                        android:textSize="15sp"
                        android:minHeight="48dp" />
                </com.hjq.shape.layout.ShapeRelativeLayout>

                <!-- Email Field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/colorTextDeep"
                    android:textSize="15sp"
                    android:layout_marginTop="14dp"
                    android:text="@string/email"
                    android:textStyle="bold" />

                <com.hjq.shape.layout.ShapeRelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:shape_radius="12dp"
                    app:shape_solidColor="@color/light_gray">

                    <com.hjq.shape.view.ShapeEditText
                        android:id="@+id/emailEt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@null"
                        android:textCursorDrawable="@drawable/cursor_color"
                        android:hint="@string/hint_email"
                        android:inputType="textEmailAddress"
                        android:drawableStart="@drawable/mail_24"
                        android:drawablePadding="8dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingVertical="10dp"
                        android:textColor="@color/colorTextDeep"
                        android:textColorHint="@color/colorTextHint"
                        android:textSize="15sp"
                        android:minHeight="48dp" />
                </com.hjq.shape.layout.ShapeRelativeLayout>

                <!-- Password Field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/password"
                        android:textColor="@color/colorTextDeep"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/passwordVisibilityToggle"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/visibility_off_24px"
                        android:contentDescription="@string/password"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:paddingTop="4dp"
                        android:paddingBottom="2dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:visibility="gone" />
                </LinearLayout>

                <com.hjq.shape.layout.ShapeRelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:shape_radius="12dp"
                    app:shape_solidColor="@color/light_gray">

                    <com.hjq.shape.view.ShapeEditText
                        android:id="@+id/passEt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/passwordClearButton"
                        android:background="@null"
                        android:textCursorDrawable="@drawable/cursor_color"
                        android:hint="@string/hint_password"
                        android:inputType="textPassword"
                        android:drawableStart="@drawable/lock_24px"
                        android:drawablePadding="8dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingVertical="10dp"
                        android:textColor="@color/colorTextDeep"
                        android:textColorHint="@color/colorTextHint"
                        android:textSize="15sp"
                        android:minHeight="48dp" />

                    <ImageView
                        android:id="@+id/passwordClearButton"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_close_circle_24"
                        android:contentDescription="@string/dialog_button_cancel"
                        android:visibility="gone"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="4dp" />
                </com.hjq.shape.layout.ShapeRelativeLayout>

                <!-- Confirm Password Field -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/confirm_password"
                        android:textColor="@color/colorTextDeep"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:id="@+id/confirmPasswordVisibilityToggle"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/visibility_off_24px"
                        android:contentDescription="@string/confirm_password"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:paddingTop="4dp"
                        android:paddingBottom="2dp"
                        android:paddingStart="2dp"
                        android:paddingEnd="2dp"
                        android:visibility="gone" />
                </LinearLayout>

                <com.hjq.shape.layout.ShapeRelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    app:shape_radius="12dp"
                    app:shape_solidColor="@color/light_gray">

                    <com.hjq.shape.view.ShapeEditText
                        android:id="@+id/passAgainEt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toStartOf="@id/confirmPasswordClearButton"
                        android:background="@null"
                        android:textCursorDrawable="@drawable/cursor_color"
                        android:hint="@string/confirm_password_hint"
                        android:inputType="textPassword"
                        android:drawableStart="@drawable/enhanced_encryption_24px"
                        android:drawablePadding="8dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingVertical="10dp"
                        android:textColor="@color/colorTextDeep"
                        android:textColorHint="@color/colorTextHint"
                        android:textSize="15sp"
                        android:minHeight="48dp" />

                    <ImageView
                        android:id="@+id/confirmPasswordClearButton"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="12dp"
                        android:src="@drawable/ic_close_circle_24"
                        android:contentDescription="@string/dialog_button_cancel"
                        android:visibility="gone"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:padding="4dp" />
                </com.hjq.shape.layout.ShapeRelativeLayout>

                <!-- Register Button -->
                <com.hjq.shape.view.ShapeButton
                    android:id="@+id/registerBtn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:paddingVertical="12dp"
                    android:text="@string/create_account"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:minHeight="48dp"
                    android:foreground="@drawable/ripple_effect_rounded_14dp"
                    android:clipToOutline="true"
                    app:shape_radius="14dp"
                    app:shape_solidColor="@color/main_color" />

                <!-- Bottom spacer -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="40dp" />

            </LinearLayout>
        </ScrollView>

        <!-- Top Bar with Gradient - overlays scrollable content -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bottom_sheet_scroll_fade_top_rounded"
            android:elevation="2dp"
            android:clipToOutline="true">

            <!-- Close button on the left with brand color -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/closeButton"
                style="?attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginStart="0dp"
                android:layout_marginTop="8dp"
                android:text="@string/dialog_button_cancel"
                android:textColor="@color/main_color"
                android:textSize="14sp"
                android:minWidth="0dp" />

            <!-- Navigation title - inline mode like iOS -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="@string/register_activity_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/colorTextDeep" />

        </RelativeLayout>

    </FrameLayout>

    <!-- Bottom spacer -->
    <View
        android:layout_width="match_parent"
        android:layout_height="24dp" />

</LinearLayout>
