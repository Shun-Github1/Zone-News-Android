<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:background="@drawable/bottom_line">

    <!-- Right-aligned image spanning full section height -->
    <ImageView
        android:id="@+id/news_iv"
        android:layout_width="95dp"
        android:layout_height="0dp"
        android:layout_marginTop="3dp"
        android:layout_marginBottom="2dp"
        android:layout_marginEnd="8dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="@id/left_content_container"
        app:layout_constraintBottom_toBottomOf="@id/left_content_container"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Left stack: fully left-aligned; width equals space before image -->
    <LinearLayout
        android:id="@+id/left_content_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="3dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="10dp"
        android:minWidth="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/news_iv"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- place | divider | tag row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/place_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/placeholder_text"
                android:textColor="@color/colorTextSmall"
                android:textSize="12sp" />
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="4dp"
                android:background="@color/colorTextSmall" />
            <TextView
                android:id="@+id/tag_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/placeholder_text"
                android:textColor="@color/colorTextSmall"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/news_title_tv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:minWidth="0dp"
            android:text="@string/placeholder_text"
            android:textColor="@color/colorTextDeep"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Sentiment row with bar and reports/time -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp">

            <!-- Sentiment text (Positive/Negative/Neutral) -->
            <TextView
                android:id="@+id/trans_score_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/colorTextSmall"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Reports count and time (right aligned) -->
            <LinearLayout
                android:id="@+id/reports_time_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">
                <TextView
                    android:id="@+id/news_count_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reports_count"
                    android:textColor="@color/colorTextSmall"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/dot_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/bullet_point"
                    android:textColor="@color/colorTextSmall"
                    android:textSize="10sp"
                    android:layout_marginHorizontal="2dp" />
                <TextView
                    android:id="@+id/news_time_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time_placeholder"
                    android:textColor="@color/colorTextSmall"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Sentiment progress bar -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/trans_score_tv">

                <View
                    android:id="@+id/progress_track"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_sentiment_track"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <View
                    android:id="@+id/progress_highlight"
                    android:layout_width="0dp"
                    android:layout_height="3dp"
                    android:background="@drawable/bg_progress_positive"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="@id/progress_track"
                    app:layout_constraintBottom_toBottomOf="@id/progress_track" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="6dp"
                    android:background="@color/colorTextSmall"
                    app:layout_constraintTop_toTopOf="@id/progress_track"
                    app:layout_constraintBottom_toBottomOf="@id/progress_track"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
