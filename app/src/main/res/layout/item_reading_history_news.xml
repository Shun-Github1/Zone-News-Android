<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@android:color/transparent"
    android:paddingStart="6dp"
    android:paddingEnd="0dp"
    android:paddingVertical="8dp">

    <!-- Date and time at the top -->
    <TextView
        android:id="@+id/dateTimeText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="@color/colorTextSmall"
        android:layout_marginBottom="8dp"
        android:fontFamily="sans-serif-light" />

    <!-- News content row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <!-- News title (left side) -->
        <TextView
            android:id="@+id/newsTitleText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textColor="@color/colorTextDeep"
            android:maxLines="3"
            android:ellipsize="end"
            android:layout_marginEnd="12dp"
            android:lineSpacingExtra="2dp"
            android:textStyle="bold" />

        <!-- News image (right side) -->
        <ImageView
            android:id="@+id/newsImage"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:background="@drawable/bottom_line"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null" />

        <!-- Chevron button (rightmost) -->
        <ImageView
            android:id="@+id/chevronButton"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/icon_arrow_regular_right"
            android:contentDescription="@null"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/colorTextMiddle"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="0dp" />

    </LinearLayout>



</LinearLayout>
