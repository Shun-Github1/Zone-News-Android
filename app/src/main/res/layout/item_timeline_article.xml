<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="200dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="10dp">

    <TextView
        android:id="@+id/timeline_item_title"
        android:layout_width="180dp"
        android:layout_height="60dp"
        android:gravity="center"
        android:textColor="@color/colorTextDeep"
        android:textSize="12sp"
        android:maxLines="3"
        android:ellipsize="end"/>

    <!-- Marker circle with background hole effect will be drawn by layered views -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp">

        <!-- Background circle to create the line passing through effect (colorSurface) -->
        <View
            android:id="@+id/timeline_item_circle_bg"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:background="@drawable/timeline_circle_bg"/>

        <!-- Foreground main marker -->
        <View
            android:id="@+id/timeline_item_circle"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_gravity="center"
            android:background="@drawable/timeline_circle"/>
    </FrameLayout>

    <TextView
        android:id="@+id/timeline_item_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="@color/colorTextSmall"
        android:textSize="11sp"/>

</LinearLayout>


