<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Topic Row -->
    <LinearLayout
        android:id="@+id/topic_row"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <!-- Topic Icon -->
        <ImageView
            android:id="@+id/topic_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_security_24"
            android:contentDescription="@null"
            android:layout_marginEnd="16dp" />

        <!-- Topic Name -->
        <TextView
            android:id="@+id/topic_tv"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/topic_name"
            android:textSize="15sp"
            android:textColor="@color/black"
            android:fontFamily="@font/inter_regular" />

        <!-- Selection Indicator -->
        <ImageView
            android:id="@+id/checkmark_iv"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_circle_outline"
            android:contentDescription="@null" />

    </LinearLayout>

    <!-- Divider - starts with text (icon width 24dp + margin 16dp + padding 20dp = 60dp) -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        android:layout_marginStart="60dp"
        android:background="@color/divider_color" />

</LinearLayout>
