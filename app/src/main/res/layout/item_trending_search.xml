<?xml version="1.0" encoding="utf-8"?>
<com.hjq.shape.layout.ShapeConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/bottom_line"
    android:paddingVertical="8dp"
    android:paddingLeft="2dp"
    android:paddingRight="8dp">

    <!-- Ranking number -->
    <TextView
        android:id="@+id/ranking_tv"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:text="1"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/main_color"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/news_iv"
        app:layout_constraintBottom_toBottomOf="@id/news_iv" />

    <!-- News Image -->
    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:contentDescription="@null"
        android:id="@+id/news_iv"
        android:scaleType="centerCrop"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title -->
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textSize="16sp"
        android:textColor="@color/colorTextDeep"
        android:textStyle="bold"
        android:maxLines="3"
        android:ellipsize="end"
        android:id="@+id/news_title_tv"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toTopOf="@id/news_iv"
        app:layout_constraintBottom_toBottomOf="@id/news_iv"
        app:layout_constraintEnd_toStartOf="@id/news_iv"
        app:layout_constraintStart_toEndOf="@id/ranking_tv" />



</com.hjq.shape.layout.ShapeConstraintLayout>
