<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/sort_popup_background"
    android:padding="4dp">

    <!-- Straightforward option -->
    <LinearLayout
        android:id="@+id/option_straightforward"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="16dp"
            android:layout_height="16dp">
            <ImageView
                android:id="@+id/check_straightforward"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_check"
                android:contentDescription="@null"
                android:visibility="gone"
                app:tint="@color/colorTextDeep"/>
        </FrameLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_arrow_circle_right_24"
            android:tint="@color/brand_primary"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/straightforward"
            android:textSize="14sp"
            android:textColor="@color/colorTextDeep"
            android:fontFamily="@font/inter_regular" />
    </LinearLayout>

    <!-- Nuanced option -->
    <LinearLayout
        android:id="@+id/option_nuanced"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="16dp"
            android:layout_height="16dp">
            <ImageView
                android:id="@+id/check_nuanced"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_check"
                android:contentDescription="@null"
                android:visibility="gone"
                app:tint="@color/colorTextDeep"/>
        </FrameLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_graphic_eq_24"
            android:tint="@color/brand_primary"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/nuanced"
            android:textSize="14sp"
            android:textColor="@color/colorTextDeep"
            android:fontFamily="@font/inter_regular" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="8dp"
        android:background="@color/divider_color" />

    <!-- English option -->
    <LinearLayout
        android:id="@+id/option_english"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="16dp"
            android:layout_height="16dp">
            <ImageView
                android:id="@+id/check_english"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_check"
                android:contentDescription="@null"
                android:visibility="gone"
                app:tint="@color/colorTextDeep"/>
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/english"
            android:textSize="14sp"
            android:textColor="@color/colorTextDeep"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/inter_regular" />
    </LinearLayout>

    <!-- Traditional Chinese option -->
    <LinearLayout
        android:id="@+id/option_traditional_chinese"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="16dp"
            android:layout_height="16dp">
            <ImageView
                android:id="@+id/check_traditional_chinese"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_check"
                android:contentDescription="@null"
                android:visibility="gone"
                app:tint="@color/colorTextDeep"/>
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/traditional_chinese"
            android:textSize="14sp"
            android:textColor="@color/colorTextDeep"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/inter_regular" />
    </LinearLayout>

    <!-- Simplified Chinese option -->
    <LinearLayout
        android:id="@+id/option_simplified_chinese"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="16dp"
            android:layout_height="16dp">
            <ImageView
                android:id="@+id/check_simplified_chinese"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_check"
                android:contentDescription="@null"
                android:visibility="gone"
                app:tint="@color/colorTextDeep"/>
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/simplified_chinese"
            android:textSize="14sp"
            android:textColor="@color/colorTextDeep"
            android:layout_marginStart="12dp"
            android:fontFamily="@font/inter_regular" />
    </LinearLayout>

</LinearLayout>
