<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="240dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/sort_popup_background"
    android:padding="4dp">

    <!-- Publisher Name -->
    <LinearLayout
        android:id="@+id/sort_publisher_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="16dp"
            android:layout_height="16dp">
            <ImageView
                android:id="@+id/check_publisher_name"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_check"
                android:contentDescription="@null"
                android:visibility="visible"
                app:tint="@color/colorTextDeep"/>
        </FrameLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_building_2_24"
            android:contentDescription="@null"
            app:tint="@color/colorTextDeep"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/publisher_name"
            android:textSize="14sp"
            android:textColor="@color/colorTextDeep"
            android:fontFamily="@font/inter_regular" />
    </LinearLayout>

    <!-- Media Significance -->
    <LinearLayout
        android:id="@+id/sort_media_significance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="16dp"
            android:layout_height="16dp">
            <ImageView
                android:id="@+id/check_media_significance"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_check"
                android:contentDescription="@null"
                android:visibility="gone"
                app:tint="@color/colorTextDeep"/>
        </FrameLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_media_significance_24"
            android:contentDescription="@null"
            app:tint="@color/colorTextDeep"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/media_significance"
            android:textSize="14sp"
            android:textColor="@color/colorTextDeep"
            android:fontFamily="@font/inter_regular" />
    </LinearLayout>

    <!-- Publisher Bias -->
    <LinearLayout
        android:id="@+id/sort_publisher_bias"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="16dp"
            android:layout_height="16dp">
            <ImageView
                android:id="@+id/check_publisher_bias"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_check"
                android:contentDescription="@null"
                android:visibility="gone"
                app:tint="@color/colorTextDeep"/>
        </FrameLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_publisher_bias_24"
            android:contentDescription="@null"
            app:tint="@color/colorTextDeep"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/publisher_bias"
            android:textSize="14sp"
            android:textColor="@color/colorTextDeep"
            android:fontFamily="@font/inter_regular" />
    </LinearLayout>


    <!-- Article Title -->
    <LinearLayout
        android:id="@+id/sort_article_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">

        <FrameLayout
            android:layout_width="16dp"
            android:layout_height="16dp">
            <ImageView
                android:id="@+id/check_article_title"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_check"
                android:contentDescription="@null"
                android:visibility="gone"
                app:tint="@color/colorTextDeep"/>
        </FrameLayout>

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_article_title_24"
            android:contentDescription="@null"
            app:tint="@color/colorTextDeep"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/article_title"
            android:textSize="14sp"
            android:textColor="@color/colorTextDeep"
            android:fontFamily="@font/inter_regular" />
    </LinearLayout>


</LinearLayout>
