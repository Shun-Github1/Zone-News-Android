<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/tutorial_bubble_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <ImageView
            android:id="@+id/close_iv"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="end"
            android:contentDescription="@null"
            android:src="@drawable/icon_popup_close_default"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tutorial_bubble_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="15sp"
            android:textColor="@color/tutorial_bubble_text"
            android:lineSpacingExtra="3dp"
            android:fontFamily="@font/inter_regular" />

        <TextView
            android:id="@+id/tap_to_continue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tutorial_tap_to_continue"
            android:textSize="12sp"
            android:textColor="@color/tutorial_bubble_hint"
            android:textStyle="italic"
            android:fontFamily="@font/inter_regular" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
