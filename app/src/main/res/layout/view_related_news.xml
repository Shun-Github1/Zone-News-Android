<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/card_content_background"
    android:padding="16dp">

    <!-- Header with title and control buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/related_news_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/related"
            android:textColor="@color/colorTextDeep"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/chevron_btn"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_chevron_down_24"
            android:tint="@color/colorTextMiddle" />

        <ImageView
            android:id="@+id/menu_btn"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_menu_24"
            android:tint="@color/colorTextMiddle"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Container for topic sections -->
    <LinearLayout
        android:id="@+id/related_news_sections_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="12dp"
        android:orientation="vertical" />

</LinearLayout>
