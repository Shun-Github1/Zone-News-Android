<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="0dp"
    android:background="@drawable/widget_background"
    tools:minWidth="250dp"
    tools:minHeight="60dp">

    <!-- Layer 1: Content (Full Width) -->
    <LinearLayout
        android:id="@+id/widget_content_wrapper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:visibility="visible"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Image Container with app logo overlay -->
        <FrameLayout
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp">

            <ImageView
                android:id="@+id/widget_news_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:contentDescription="@string/widget_news_image"
                android:src="@drawable/widget_image_placeholder" />
                
            <!-- Small app icon in corner -->
            <ImageView
                android:id="@+id/widget_logo"
                android:layout_width="wrap_content"
                android:layout_height="24dp"
                android:adjustViewBounds="true"
                android:layout_gravity="bottom|start"
                android:background="@drawable/widget_brand_overlay_bg"
                android:src="@mipmap/widget_brand_logo"
                android:contentDescription="@null" />
        </FrameLayout>

        <!-- Content Container -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <!-- Headline -->
            <TextView
                android:id="@+id/widget_headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="@string/about_desc_1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Layer 2: Loading Overlay -->
    <LinearLayout
        android:id="@+id/widget_loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="@drawable/widget_background">
        
        <ImageView
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="10dp"
            android:background="@color/widget_shimmer_color"
            android:contentDescription="@null"/>
            
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical">
            
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="14dp"
                android:layout_marginBottom="6dp"
                android:background="@color/widget_shimmer_color"
                android:contentDescription="@null"/>
            <ImageView
                android:layout_width="120dp"
                android:layout_height="14dp"
                android:background="@color/widget_shimmer_color"
                android:contentDescription="@null"/>
        </LinearLayout>
    </LinearLayout>
    
    <!-- Layer 3: Error Overlay -->
    <LinearLayout
        android:id="@+id/widget_error_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center"
        android:visibility="gone"
        android:background="@drawable/widget_background">
        
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@null" />
            
        <TextView
            android:id="@+id/widget_error_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/widget_tap_to_refresh"
            android:textColor="@color/colorTextSmall"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Layer 4: Floating Controls (Top Z-Index) -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/widget_btn_prev"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="-12dp"
            android:padding="10dp"
            android:alpha="0.5"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_chevron_left_24"
            android:tint="@color/text_tertiary"
            android:scaleType="centerInside"
            android:contentDescription="Previous" />

        <TextView
            android:id="@+id/widget_page_tracker"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:padding="0dp"
            android:includeFontPadding="false"
            android:gravity="bottom|end"
            android:textColor="@color/colorTextSmall"
            android:textSize="9sp"
            android:text="1/8" />

        <ImageView
            android:id="@+id/widget_btn_next"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="-12dp"
            android:padding="10dp"
            android:alpha="0.5"
            android:background="@android:color/transparent"
            android:src="@drawable/ic_chevron_right_24"
            android:tint="@color/text_tertiary"
            android:scaleType="centerInside"
            android:contentDescription="Next" />
    </RelativeLayout>

</FrameLayout>
