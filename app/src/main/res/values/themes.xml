<resources>

    <style name="AppTheme" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- System bar colors -->
        <item name="android:statusBarColor">@color/surface_primary</item>
        <item name="android:navigationBarColor">@color/surface_primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- windowLightNavigationBar requires API 27, but minSdk is 24 -->
        <!-- Override to prevent any system purple from appearing -->
        <item name="android:fontFamily">@font/custom</item>
        <!-- Explicit background colors to prevent system reversion -->
        <item name="android:colorBackground">@color/surface_primary</item>
        <item name="android:windowBackground">@color/surface_primary</item>
        <item name="colorSurface">@color/surface_primary</item>
        <item name="colorSurfaceVariant">@color/surface_secondary</item>
        <!-- Explicit Material3 color attributes to prevent system reversion -->
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_disabled</item>
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorError">@color/error</item>
        <item name="colorOutline">@color/outline</item>
        <!-- Add these lines -->
        <item name="android:textViewStyle">@style/GlobalTextViewStyle</item>
        <item name="radioButtonStyle">@style/GlobalRadioButtonStyle</item>
        <item name="buttonStyle">@style/GlobalButtonStyle</item>
        <item name="editTextStyle">@style/GlobalEditTextStyle</item>
        <item name="android:editTextStyle">@style/GlobalEditTextStyle</item>
        <item name="checkboxStyle">@style/GlobalCheckboxStyle</item>
        <item name="switchStyle">@style/GlobalSwitchStyle</item>
        <!-- Image placeholder background -->
        <item name="imagePlaceholderBackground">@color/image_placeholder_background</item>
    </style>

    <!-- Define the global TextView style -->
    <style name="GlobalTextViewStyle" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/custom</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <!-- Define the global RadioButton style -->
    <style name="GlobalRadioButtonStyle" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:fontFamily">@font/custom</item>
    </style>

    <!-- Define the global Button style -->
    <style name="GlobalButtonStyle" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/custom</item>
    </style>

    <!-- Define the global EditText style (applies to AppCompat and framework EditText) -->
    <style name="GlobalEditTextStyle" parent="Widget.AppCompat.EditText">
        <item name="android:fontFamily">@font/custom</item>
        <item name="android:textCursorDrawable">@drawable/cursor_color</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <!-- Define the global Checkbox style -->
    <style name="GlobalCheckboxStyle" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="android:fontFamily">@font/custom</item>
    </style>

    <!-- Define the global Switch style -->
    <style name="GlobalSwitchStyle" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="android:fontFamily">@font/custom</item>
    </style>

    <style name="tabStyle">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@drawable/selecter_text</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:button">@null</item>
        <item name="android:layout_weight">1</item>
        <item name="android:fontFamily">@font/custom</item>
    </style>

    <!-- Topic Selection Tab Style -->
    <style name="TopicTabStyle" parent="Widget.Material3.CompoundButton.RadioButton">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:paddingVertical">4dp</item>
        <item name="android:background">@null</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:button">@null</item>
        <item name="android:fontFamily">@font/custom</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <style name="horizontal_slide" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowAnimationStyle">@style/AnimFade2</item>
        <item name="android:fontFamily">@font/custom</item>
        <!-- System bar colors for consistent appearance -->
        <item name="android:statusBarColor">@color/surface_primary</item>
        <item name="android:navigationBarColor">@color/surface_primary</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Explicit background colors to prevent system reversion -->
        <item name="android:colorBackground">@color/surface_primary</item>
        <item name="android:windowBackground">@color/surface_primary</item>
        <item name="colorSurface">@color/surface_primary</item>
        <item name="colorSurfaceVariant">@color/surface_secondary</item>
        <!-- Explicit Material3 color attributes to prevent system reversion -->
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorOnSurfaceVariant">@color/text_disabled</item>
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/colorOnPrimary</item>
        <item name="colorError">@color/error</item>
        <item name="colorOutline">@color/outline</item>
        <!-- Image placeholder background -->
        <item name="imagePlaceholderBackground">@color/image_placeholder_background</item>
    </style>

    <style name="TabText" parent="TextAppearance.Material3.LabelLarge">
        <item name="textAllCaps">false</item>
        <item name="android:fontFamily">@font/custom</item>
        <item name="android:textSize">14sp</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="AnimFade2" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/fade_in</item>
        <item name="android:activityOpenExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseExitAnimation">@anim/fade_out</item>
        <item name="android:activityCloseEnterAnimation">@anim/fade_in</item>
        <item name="android:fontFamily">@font/custom</item>
    </style>
    <!-- Dialog 样式-->
    <!--弹出框 动画-->
    <style name="DialogAnimation" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/fade_in</item>
        <item name="android:windowExitAnimation">@anim/fade_out</item>
    </style>

    <!-- Bottom Sheet 样式-->
    <!--底部弹出框 动画-->
    <style name="BottomSheetAnimation" parent="@android:style/Animation.Dialog">
        <item name="android:windowEnterAnimation">@anim/slide_up_from_bottom</item>
        <item name="android:windowExitAnimation">@anim/slide_down_to_bottom</item>
    </style>

    <!-- Material 3 Typography Styles -->

    <!-- Profile heading style matching the profile page -->
    <style name="ProfileHeadingStyle" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/colorTextDeep</item>
        <item name="android:fontFamily">@font/custom</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <!-- URL text style for browser toolbar - smaller and unbold -->
    <style name="BrowserUrlTextStyle" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textStyle">normal</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/colorTextDeep</item>
        <item name="android:fontFamily">@font/custom</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <!-- Custom Material3 TextAppearance overrides with consistent line spacing -->
    <style name="TextAppearance.Material3.HeadlineLarge.Custom" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>
    <style name="TextAppearance.Material3.HeadlineMedium.Custom" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>
    <style name="TextAppearance.Material3.HeadlineSmall.Custom" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>
    <style name="TextAppearance.Material3.TitleLarge.Custom" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>
    <style name="TextAppearance.Material3.TitleMedium.Custom" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>
    <style name="TextAppearance.Material3.TitleSmall.Custom" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>
    <style name="TextAppearance.Material3.BodyLarge.Custom" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>
    <style name="TextAppearance.Material3.BodyMedium.Custom" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>
    <style name="TextAppearance.Material3.BodySmall.Custom" parent="TextAppearance.Material3.BodySmall">
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>
    <style name="TextAppearance.Material3.LabelLarge.Custom" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>
    <style name="TextAppearance.Material3.LabelMedium.Custom" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>
    <style name="TextAppearance.Material3.LabelSmall.Custom" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <style name="CircleDetails">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

</resources>
