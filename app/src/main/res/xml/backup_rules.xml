<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules file - excludes authentication data from backup
   to prevent auto-login after app reinstall
-->
<full-backup-content>
    <!-- Exclude authentication SharedPreferences from backup -->
    <exclude domain="sharedpref" path="shunxingass.xml"/>
    <exclude domain="sharedpref" path="cookie_prefs.xml"/>
    <!-- Exclude Firebase Auth data -->
    <exclude domain="sharedpref" path="com.google.firebase.auth.xml"/>
</full-backup-content>