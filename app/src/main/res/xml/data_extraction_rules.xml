<?xml version="1.0" encoding="utf-8"?><!--
   Data extraction rules - excludes authentication data from cloud backup and device transfer
   to prevent auto-login after app reinstall or device transfer
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude authentication SharedPreferences from cloud backup -->
        <exclude domain="sharedpref" path="shunxingass.xml"/>
        <exclude domain="sharedpref" path="cookie_prefs.xml"/>
        <!-- Exclude Firebase Auth data -->
        <exclude domain="sharedpref" path="com.google.firebase.auth.xml"/>
    </cloud-backup>
    <device-transfer>
        <!-- Exclude authentication SharedPreferences from device transfer -->
        <exclude domain="sharedpref" path="shunxingass.xml"/>
        <exclude domain="sharedpref" path="cookie_prefs.xml"/>
        <!-- Exclude Firebase Auth data -->
        <exclude domain="sharedpref" path="com.google.firebase.auth.xml"/>
    </device-transfer>
</data-extraction-rules>